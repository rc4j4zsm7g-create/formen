<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>formen</title>
    <style>
        body { background: #0f0f0f; color: #fff; font-family: sans-serif; margin: 0; padding: 15px; text-align: center; }
        .card { background: #1a1a1a; border-radius: 10px; padding: 15px; max-width: 400px; margin: 0 auto 20px; border: 1px solid #2a2a2a; }
        img { width: 100%; height: 350px; object-fit: cover; border-radius: 8px; background: #333; }
        .btn { background: #2563eb; color: #fff; border: none; padding: 12px 20px; border-radius: 6px; font-weight: bold; cursor: pointer; margin-top: 15px; width: 100%; font-size: 15px; }
        .chips { display: flex; justify-content: center; gap: 8px; margin: 10px 0; flex-wrap: wrap; }
        .chip { background: #2a2a2a; padding: 6px 12px; border-radius: 5px; cursor: pointer; border: 1px solid #444; font-size: 14px; }
        .chip.active { background: #2563eb; border-color: #2563eb; }
        .menu { margin-bottom: 20px; display: flex; justify-content: center; gap: 10px; }
        .menu button { padding: 10px 20px; background: #222; color: #aaa; border: 1px solid #444; border-radius: 6px; cursor: pointer; font-weight: bold; }
        .menu button.active { background: #fff; color: #000; border-color: #fff; }
    </style>
</head>
<body>

    <h1>FORMEN</h1>
    
    <div class="menu">
        <button id="btn-lac" class="active" onclick="setBrand('lacoste')">Lacoste</button>
        <button id="btn-fred" onclick="setBrand('fredperry')">Fred Perry</button>
    </div>

    <div class="card">
        <h2 id="title" style="font-size: 18px; margin-bottom: 10px;">Костюм Lacoste</h2>
        <img id="product-img" src="https://i.postimg.cc/kMB1dRSJ/IMG-3808.jpg" alt="photo">
        <div id="price" style="color: #4ade80; font-size: 18px; font-weight: bold; margin: 10px 0;">1999 грн</div>
        
        <div style="font-size: 13px; color: #aaa; margin-top: 10px;">Цвет:</div>
        <div id="colors" class="chips"></div>

        <button class="btn" onclick="order()">Заказать</button>
    </div>

    <script>
        const BOT_TOKEN = "7547055745:AAFS1M2T0aX5xK_Z1R2w4_Q8hP5J7j0x8u4"; 
        const CHAT_ID = "612842183";

        const data = {
            lacoste: {
                name: "Костюм Lacoste",
                price: "1999 грн",
                colors: [
                    { name: "Молочный", img: "https://i.postimg.cc/kMB1dRSJ/IMG-3808.jpg" },
                    { name: "Черный", img: "https://i.postimg.cc/cvLN6FwF/IMG-3822.jpg" },
                    { name: "Зеленый", img: "https://i.postimg.cc/sMh4PrYJ/IMG-3823.jpg" }
                ]
            },
            fredperry: {
                name: "Костюм Fred Perry",
                price: "1899 грн",
                colors: [
                    { name: "Молочный", img: "https://i.postimg.cc/CdCCmg6Q/IMG-3122.jpg" },
                    { name: "Бордовый", img: "https://i.postimg.cc/V599D8Hh/IMG-3123.jpg" },
                    { name: "Черный", img: "https://i.postimg.cc/dDRR4YSW/IMG-3124.jpg" },
                    { name: "Блакитный", img: "https://i.postimg.cc/vD773sSS/IMG-3125.jpg" }
                ]
            }
        };

        let current = 'lacoste';
        let colorIdx = 0;

        function setBrand(brand) {
            current = brand;
            colorIdx = 0;
            document.getElementById('btn-lac').className = brand === 'lacoste' ? 'active' : '';
            document.getElementById('btn-fred').className = brand === 'fredperry' ? 'active' : '';
            render();
        }

        function render() {
            let item = data[current];
            document.getElementById('title').innerText = item.name;
            document.getElementById('price').innerText = item.price;
            document.getElementById('product-img').src = item.colors[colorIdx].img;

            let chipsHtml = '';
            item.colors.forEach((c, idx) => {
                chipsHtml += `<div class="chip ${idx === colorIdx ? 'active' : ''}" onclick="colorIdx = ${idx}; render()">${c.name}</div>`;
            });
            document.getElementById('colors').innerHTML = chipsHtml;
        }

        function order() {
            let item = data[current];
            let color = item.colors[colorIdx].name;
            let contact = prompt("Введите ваш Telegram (@username) или номер телефона для связи:");
            
            if (!contact) return;

            let message = `🔥 Новый заказ Formen!\n\n📦 Товар: ${item.name}\n🎨 Цвет: ${color}\n💰 Цена: ${item.price}\n👤 Контакт: ${contact}`;

            fetch(`https://api.telegram.org/bot${BOT_TOKEN}/sendMessage`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    chat_id: CHAT_ID,
                    text: message
                })
            })
            .then(response => {
                if (response.ok) {
                    alert("Заказ успешно отправлен!");
                } else {
                    alert("Ошибка отправки. Попробуйте еще раз.");
                }
            })
            .catch(() => {
                alert("Ошибка сети.");
            });
        }

        render();
    </script>
</body>
</html>
