<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>formen — Store</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
        body { background-color: #0f0f0f; color: #ffffff; padding-bottom: 80px; }
        header { background: #1a1a1a; padding: 15px; text-align: center; border-bottom: 1px solid #333; position: sticky; top: 0; z-index: 100; }
        h1 { font-size: 22px; font-weight: 700; letter-spacing: 1px; color: #fff; }
        .brand-selector { display: flex; justify-content: center; gap: 10px; padding: 15px; background: #141414; }
        .brand-btn { background: #222; color: #aaa; border: none; padding: 10px 20px; border-radius: 8px; font-weight: 600; cursor: pointer; transition: 0.2s; }
        .brand-btn.active { background: #fff; color: #000; }
        .container { padding: 15px; max-width: 600px; margin: 0 auto; }
        .catalog { display: grid; grid-template-columns: 1fr; gap: 16px; }
        .card { background: #1a1a1a; border-radius: 12px; overflow: hidden; border: 1px solid #2a2a2a; display: flex; flex-direction: column; }
        .card img { width: 100%; height: 340px; object-fit: cover; background: #252525; }
        .card-body { padding: 15px; display: flex; flex-direction: column; justify-content: space-between; gap: 12px; }
        .title { font-size: 16px; font-weight: 600; }
        .price { font-size: 16px; font-weight: 700; color: #4ade80; }
        
        .options-section { display: flex; flex-direction: column; gap: 8px; }
        .options-section label { font-size: 12px; color: #aaa; text-transform: uppercase; letter-spacing: 0.5px; }
        .chips { display: flex; gap: 8px; flex-wrap: wrap; }
        .chip { background: #2a2a2a; border: 1px solid #3a3a3a; padding: 6px 12px; border-radius: 6px; color: #fff; cursor: pointer; font-size: 13px; }
        .chip.selected { border-color: #2563eb; background: #1d4ed8; }
        
        .btn { background: #2563eb; color: #fff; border: none; padding: 12px; border-radius: 8px; width: 100%; font-weight: 600; cursor: pointer; text-align: center; font-size: 15px; }
        .btn:active { opacity: 0.8; }
        
        /* Modal */
        .modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.85); z-index: 1000; align-items: flex-end; }
        .modal-content { background: #1e1e1e; width: 100%; border-radius: 20px 20px 0 0; padding: 20px; max-height: 90vh; overflow-y: auto; }
        .modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; }
        .close-btn { background: none; border: none; color: #fff; font-size: 24px; cursor: pointer; }
        input[type="text"] { width: 100%; padding: 12px; background: #2a2a2a; border: 1px solid #3a3a3a; border-radius: 8px; color: #fff; font-size: 14px; margin-bottom: 15px; }
    </style>
</head>
<body>

    <header>
        <h1>formen</h1>
    </header>

    <div class="brand-selector">
        <button class="brand-btn active" onclick="switchBrand('lacoste')">Lacoste</button>
        <button class="brand-btn" onclick="switchBrand('fredperry')">Fred Perry</button>
    </div>

    <div class="container">
        <div id="catalog" class="catalog"></div>
    </div>

    <div id="orderModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3 style="font-size: 16px;">Оформление заказа</h3>
                <button class="close-btn" onclick="closeModal()">&times;</button>
            </div>
            <div style="margin-bottom: 15px; font-size: 14px; color: #ccc; line-height: 1.5;" id="modalSummary"></div>
            <div class="options-section" style="margin-bottom: 15px;">
                <label>Ваш Telegram / Телефон:</label>
                <input type="text" id="userContact" placeholder="@username или номер">
            </div>
            <button class="btn" onclick="submitOrder()">Подтвердить заказ</button>
        </div>
    </div>

    <script>
        const products = {
            lacoste: [
                { 
                    id: 1, 
                    name: "Костюм Lacoste", 
                    price: "3490 грн", 
                    sizes: ["S", "M", "L", "XL", "XXL"],
                    colors: [
                        { name: "Молочный", img: "https://i.postimg.cc/kMB1dRSJ/IMG-3808.jpg" },
                        { name: "Черный", img: "https://i.postimg.cc/cvLN6FwF/IMG-3822.jpg" },
                        { name: "Зеленый", img: "https://i.postimg.cc/sMh4PrYJ/IMG-3823.jpg" }
                    ]
                }
            ],
            fredperry: [
                { 
                    id: 2, 
                    name: "Костюм Fred Perry", 
                    price: "3590 грн", 
                    sizes: ["S", "M", "L", "XL", "XXL"],
                    colors: [
                        { name: "Молочный", img: "https://i.postimg.cc/CdCCmg6Q/IMG-3122.jpg" },
                        { name: "Бордовый", img: "https://i.postimg.cc/V599D8Hh/IMG-3123.jpg" },
                        { name: "Черный", img: "https://i.postimg.cc/dDRR4YSW/IMG-3124.jpg" },
                        { name: "Блакитный", img: "https://i.postimg.cc/vD773sSS/IMG-3125.jpg" }
                    ]
                }
            ]
        };

        let currentBrand = 'lacoste';
        let state = {};

        function switchBrand(brand) {
            currentBrand = brand;
            document.querySelectorAll('.brand-btn').forEach(btn => btn.classList.remove('active'));
            event.target.classList.add('active');
            renderCatalog();
        }

        function renderCatalog() {
            const catalogEl = document.getElementById('catalog');
            catalogEl.innerHTML = '';
            
            products[currentBrand].forEach(item => {
                if (!state[item.id]) {
                    state[item.id] = { colorIdx: 0, size: item.sizes[0] };
                }
                const sel = state[item.id];
                const activeColor = item.colors[sel.colorIdx];

                let colorsHtml = item.colors.map((c, idx) => `
                    <div class="chip ${idx === sel.colorIdx ? 'selected' : ''}" onclick="selectColor(${item.id}, ${idx})">${c.name}</div>
                `).join('');

                let sizesHtml = item.sizes.map(s => `
                    <div class="chip ${s === sel.size ? 'selected' : ''}" onclick="selectSize(${item.id}, '${s}')">${s}</div>
                `).join('');

                catalogEl.innerHTML += `
                    <div class="card">
                        <img src="${activeColor.img}" alt="${item.name}">
                        <div class="card-body">
                            <div>
                                <div class="title">${item.name}</div>
                                <div class="price" style="margin-top: 4px;">${item.price}</div>
                            </div>
                            
                            <div class="options-section">
                                <label>Цвет: <span style="color:#fff">${activeColor.name}</span></label>
                                <div class="chips">${colorsHtml}</div>
                            </div>

                            <div class="options-section">
                                <label>Размер:</label>
                                <div class="chips">${sizesHtml}</div>
                            </div>

                            <button class="btn" onclick="openModal(${item.id})">Заказать</button>
                        </div>
                    </div>
                `;
            });
        }

        function selectColor(itemId, colorIdx) {
            state[itemId].colorIdx = colorIdx;
            renderCatalog();
        }

        function selectSize(itemId, size) {
            state[itemId].size = size;
            renderCatalog();
        }

        let activeOrder = null;

        function openModal(itemId) {
            const item = products[currentBrand].find(p => p.id === itemId);
            const sel = state[itemId];
            activeOrder = {
                item: item.name,
                color: item.colors[sel.colorIdx].name,
                size: sel.size,
                price: item.price
            };

            document.getElementById('modalSummary').innerHTML = `
                <b>Товар:</b> ${activeOrder.item}<br>
                <b>Цвет:</b> ${activeOrder.color}<br>
                <b>Размер:</b> ${activeOrder.size}<br>
                <b>Цена:</b> ${activeOrder.price}
            `;
            document.getElementById('orderModal').style.display = 'flex';
        }

        function closeModal() {
            document.getElementById('orderModal').style.display = 'none';
        }

        function submitOrder() {
            const contact = document.getElementById('userContact').value.trim();
            if (!contact) {
                alert('Укажите ваш контакт!');
                return;
            }
            alert(`Спасибо! Заказ оформлен.\nТовар: ${activeOrder.item} (${activeOrder.color}, ${activeOrder.size})\nСвязь: ${contact}`);
            closeModal();
            document.getElementById('userContact').value = '';
        }

        renderCatalog();
    </script>
</body>
</html>
